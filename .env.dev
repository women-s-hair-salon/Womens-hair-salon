# ===================================================
#  فایل محیطی برای تست لوکال با داکر
#  این فایل رو به .gitignore اضافه کن!
# ===================================================

# Django
SECRET_KEY=dev-secret-key-change-this-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database (باید با docker-compose.dev.yml مطابقت داشته باشه)
DB_NAME=salon_dev
DB_USER=salon_user
DB_PASSWORD=salon_pass_dev
DB_HOST=db
DB_PORT=5432

# S3 / آروان - در تست لوکال می‌تونی خاموشش کنی (فایل‌ها لوکال ذخیره میشن)
# اگه می‌خوای همچنان از آروان استفاده کنی، مقادیر واقعی رو اینجا بذار
S3_CDN_DOMAIN=

# Zarinpal - sandbox فعال
ZARINPAL_SANDBOX=True
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=

# Kavenegar - در تست لوکال می‌تونه خالی بمونه
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
ADMIN_MOBILE=

# OTP
OTP_CODE_LENGTH=4
OTP_EXPIRE_SECONDS=180
OTP_RESEND_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_DAY=5

# سالن
SALON_NAME=سیندخت بیوتی (تست)
SALON_PHONE=
SALON_ADDR=تهران